# Copy this file to /etc/hexcaster/hexcaster.env and adjust the values.
# Prefer stable ALSA CARD names from `hexcaster --list-devices` over hw:N,M.
HEXCASTER_MODEL=/var/lib/hexcaster/models/default.nam
HEXCASTER_INPUT=hw:CARD=i2,DEV=0
HEXCASTER_OUTPUT=hw:CARD=sndrpihifiberry,DEV=0
HEXCASTER_QUALITY=auto
HEXCASTER_BUFFER=128
# Analog level corresponding to 0 dBFS at the capture interface.
HEXCASTER_INPUT_LEVEL_DBU=11.63

# Optional arguments are split on whitespace by systemd. Example:
# HEXCASTER_EXTRA_ARGS=--midi-device hw:1,0,0 --midi-cc 7:InputGain_dB
HEXCASTER_EXTRA_ARGS=
